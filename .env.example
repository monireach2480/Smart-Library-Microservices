# Copy to .env  (cp .env.example .env)  and fill in. Used by the all-in-one docker-compose.yml.
POSTGRES_USER=library
# avoid @ : / # in the password (it goes into a URL)
POSTGRES_PASSWORD=change_me_use_letters_and_digits_only
# >= 32 chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# >= 16 chars, shared by all services (service-to-service calls)
INTERNAL_API_KEY=
# whoever knows this can create ADMIN accounts
ADMIN_REGISTRATION_KEY=
